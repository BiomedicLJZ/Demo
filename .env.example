# Claves (obligatorias)
NVIDIA_API_KEY=
GOOGLE_API_KEY=
# Modelos (obligatorios). Verificados con tool-calling el 2026-10-16; NIM retira modelos (llama-3.3-70b ya da 410).
NIM_MODEL=nvidia/nemotron-3-super-120b-a12b
GEMINI_MODEL=gemini-2.5-flash
# Base de datos (docker compose up -d --wait)
DATABASE_URL=postgresql://ventas_rw:ventas_rw@localhost:5433/ventas
DATABASE_URL_RO=postgresql://ventas_ro:ventas_ro@localhost:5433/ventas
# Opcionales
TASA_IMPUESTO=0.16
NIM_TIMEOUT=20
